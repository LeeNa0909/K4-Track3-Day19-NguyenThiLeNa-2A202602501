# Copy to .env (never commit .env). Get a key at https://openrouter.ai/settings/keys
# Fill OPENROUTER_API_KEY to use OpenRouter for both chat and embeddings.
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
EMBEDDING_PROVIDER=openrouter

# Optional alternatives: change the provider settings above and set the matching key.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Chat: openrouter | openai | gemini | anthropic; embeddings: openrouter | openai | gemini.
# Without explicit providers, priority is OpenRouter -> OpenAI -> Gemini -> Anthropic.
# Anthropic is chat-only and needs another provider for embeddings.

# Optional: override default models (<PROVIDER>_CHAT_MODEL / <PROVIDER>_EMBEDDING_MODEL)
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# ANTHROPIC_CHAT_MODEL=claude-opus-5-5

# Must match NEO4J_AUTH used in `docker run`
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
